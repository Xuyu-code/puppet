# Provider mode: mock for UI development, remote for a protected generation API.
PUPPET_PROVIDER_MODE=mock

# Required when PUPPET_PROVIDER_MODE=remote.
PUPPET_GENERATION_API_URL=https://your-private-service.example/generate
PUPPET_GENERATION_API_KEY=replace-with-your-secret
PUPPET_GENERATION_TIMEOUT_SECONDS=180

# Web service settings.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
